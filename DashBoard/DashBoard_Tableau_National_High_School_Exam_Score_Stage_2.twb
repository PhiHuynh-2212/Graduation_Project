              <calculation class='tableau' formula='(ZN(COUNTD([sbd])) - ZN(LOOKUP(COUNTD([sbd]), -1))) &#13;&#10;/ ABS(ZN(LOOKUP(COUNTD([sbd]), -1)))'>
