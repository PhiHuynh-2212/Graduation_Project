    <worksheet name='Số lượng trượt tốt nghiệp'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='processed' name='federated.1il4scw0pxerd217zqmif02dpi4j' />
          </datasources>
          <datasource-dependencies datasource='federated.1il4scw0pxerd217zqmif02dpi4j'>
            <column caption='Tổ Hợp Thi' datatype='string' name='[Calculation_175921886740017152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([vat_li]) AND NOT ISNULL([hoa_hoc]) AND NOT ISNULL([sinh_hoc]) THEN &quot;KHTN&quot;&#13;&#10;ELSEIF NOT ISNULL([lich_su]) AND NOT ISNULL([dia_li]) AND NOT ISNULL([gdcd]) THEN &quot;KHXH&quot;&#13;&#10;ELSE &quot;Không xác định&quot; &#13;&#10;END' />
            </column>
            <column caption='Đậu tốt nghiệp' datatype='string' name='[Calculation_175921886740496385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;    // Không có môn nào null&#13;&#10;    NOT ISNULL([toan]) AND NOT ISNULL([ngu_van]) AND NOT ISNULL([ngoai_ngu]) AND&#13;&#10;    (&#13;&#10;        ([Calculation_175921886740017152] = &quot;KHTN&quot; AND NOT ISNULL([vat_li]) AND NOT ISNULL([hoa_hoc]) AND NOT ISNULL([sinh_hoc]))&#13;&#10;        OR &#13;&#10;        ([Calculation_175921886740017152] = &quot;KHXH&quot; AND NOT ISNULL([lich_su]) AND NOT ISNULL([dia_li]) AND NOT ISNULL([gdcd]))&#13;&#10;    )&#13;&#10;    AND&#13;&#10;&#13;&#10;    // Các môn bắt buộc &gt; 1 điểm&#13;&#10;    [toan] &gt; 1 AND [ngu_van] &gt; 1 AND [ngoai_ngu] &gt; 1 AND&#13;&#10;    (&#13;&#10;        ([Calculation_175921886740017152] = &quot;KHTN&quot; AND [vat_li] &gt; 1 AND [hoa_hoc] &gt; 1 AND [sinh_hoc] &gt; 1)&#13;&#10;        OR &#13;&#10;        ([Calculation_175921886740017152] = &quot;KHXH&quot; AND [lich_su] &gt; 1 AND [dia_li] &gt; 1 AND [gdcd] &gt; 1)&#13;&#10;    )&#13;&#10;THEN &quot;Đậu&quot;&#13;&#10;ELSE &quot;Không đậu&quot;&#13;&#10;END' />
            </column>
            <column caption='Số lượng đậu tốt nghiệp' datatype='integer' name='[Calculation_175921886742716420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_175921886740496385] = &quot;Đậu&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Số lượng trượt tốt nghiệp' datatype='integer' name='[Calculation_175921886744064005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([sbd]) - SUM([Calculation_175921886742716420])' />
            </column>
            <column caption='Dia Li' datatype='real' name='[dia_li]' role='measure' type='quantitative' />
            <column caption='Gdcd' datatype='real' name='[gdcd]' role='measure' type='quantitative' />
            <column caption='Hoa Hoc' datatype='real' name='[hoa_hoc]' role='measure' type='quantitative' />
            <column caption='Lich Su' datatype='real' name='[lich_su]' role='measure' type='quantitative' />
            <column caption='Ngoai Ngu' datatype='real' name='[ngoai_ngu]' role='measure' type='quantitative' />
            <column caption='Ngu Van' datatype='real' name='[ngu_van]' role='measure' type='quantitative' />
            <column-instance column='[regions]' derivation='None' name='[none:regions:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column caption='Regions' datatype='string' name='[regions]' role='dimension' type='nominal' />
            <column caption='Sbd' datatype='integer' name='[sbd]' role='measure' type='quantitative' />
            <column caption='Sinh Hoc' datatype='real' name='[sinh_hoc]' role='measure' type='quantitative' />
            <column caption='Toan' datatype='real' name='[toan]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_175921886744064005]' derivation='User' name='[usr:Calculation_175921886744064005:qk]' pivot='key' type='quantitative' />
            <column caption='Vat Li' datatype='real' name='[vat_li]' role='measure' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1il4scw0pxerd217zqmif02dpi4j].[Action (Regions)]'>
            <groupfilter function='level-members' level='[regions]' user:ui-action-filter='[Action3_FDCAADDBE7774245B1B46371DAE31883]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1il4scw0pxerd217zqmif02dpi4j].[Action (Year)]'>
            <groupfilter function='level-members' level='[none:year:ok]' user:ui-action-filter='[Action10_E5A8EB131E0A474697BC92A6A9987167]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1il4scw0pxerd217zqmif02dpi4j].[Action (Regions)]</column>
            <column>[federated.1il4scw0pxerd217zqmif02dpi4j].[Action (Year)]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='277' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
